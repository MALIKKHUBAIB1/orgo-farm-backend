PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/orgo-farm
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production
# Required to read order and contact data from an admin-only client.
ADMIN_API_KEY=replace-with-a-long-random-secret
# Set to true only when a trusted reverse proxy supplies the client IP.
TRUST_PROXY=false
# Email notifications for contact-form submissions.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
MAIL_FROM="ORGO FARM <your-email@example.com>"
CONTACT_TO_EMAIL=your-email@example.com
